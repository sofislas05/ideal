---
// src/components/BackButton.astro

// Definimos las "props" que el componente aceptará.
// 'href' es la URL a la que el botón nos llevará y es obligatoria.
// 'class' es opcional para estilos adicionales.
export interface Props {
    href: string;
    class?: string;
}

// Obtenemos los valores de las props que nos pasen.
const { href, class: className } = Astro.props;
---

<a
    href={href}
    class:list={[
        'inline-flex items-center gap-2 transition-all duration-200 ease-in-out',
        'text-gray-600 hover:text-gray-900 underline-offset-4 hover:underline',
        className,
    ]}
>
    <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        class="flex-shrink-0"
    >
        <path
            d="M19 12H5M5 12L12 19M5 12L12 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
    </svg>
    <span>Volver</span>
</a>