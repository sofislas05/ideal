      "id": "c2144cd3-92e5-43fe-a22f-1702efd4552c",
      "comment": "",
      "command": "click",
      "target": "css=#search-bar > .text-sm",
      "targets": [
        ["css=#search-bar > .text-sm", "css:finder"],
        ["xpath=//div[@id='search-bar']/span", "xpath:idRelative"],
        ["xpath=//span", "xpath:position"],
        ["xpath=//span[contains(.,'Buscar recursos...')]", "xpath:innerText"]
